  },
  {
    "op": "replace",
    "path": "/scriptConfig/dialog/crewmember/respawned/floran/default/3",
    "value": "¡<selfname> sssentía preocupación por ti!"
  },
  {
    "op": "replace",
    "path": "/scriptConfig/dialog/crewmember/respawned/glitch/default/0",
    "value": "Desorientado. ¿Qué pasó? ¿Estás bien?"
  },
  {
    "op": "replace",
    "path": "/scriptConfig/dialog/crewmember/respawned/glitch/default/1",
    "value": "Aliviado. ¡Estás de vuelta!"
  },
  {
    "op": "replace",
    "path": "/scriptConfig/dialog/crewmember/respawned/glitch/default/2",
    "value": "Preocupado. Tenía preocupación por ti. ¿Te encuentras bien?"
  },
  {
    "op": "replace",
    "path": "/scriptConfig/dialog/crewmember/respawned/glitch/default/3",
    "value": "Reconfortado. Al menos estás a salvo de nuevo."
  },
  {
    "op": "replace",
    "path": "/scriptConfig/dialog/crewmember/respawned/novakid/default/0",
    "value": "Bueno, diablos, estaría mintiendo si dijera que no tenía preocupación por ti, compi."
  },
  {
    "op": "replace",
    "path": "/scriptConfig/dialog/crewmember/respawned/novakid/default/1",
    "value": "¿Estaba muerto? ¿Estabas muerto? ¡Supongo que deberíamos tener más cuidado!"
  },
  {
    "op": "replace",
    "path": "/scriptConfig/dialog/crewmember/respawned/novakid/default/2",
    "value": "¡Me alegra verte de vuelta por la pradera! ¿Listo para volver a montar?"
  },
  {
    "op": "replace",
    "path": "/scriptConfig/dialog/crewmember/respawned/novakid/default/3",
    "value": "Volver a la vida me da escalofrios... ¿Estás bien, compi?"
  },
  {
    "op": "replace",
    "path": "/scriptConfig/dialog/crewmember/unfollow/default/default/0",
    "value": "¡Ten cuidado! ¿vale? Esperaré por aquí."
  },
  {
    "op": "replace",
    "path": "/scriptConfig/dialog/crewmember/unfollow/default/default/1",
    "value": "Me quedaré por aquí. ¡Vuelve sano y salvo!"
  },
  {
    "op": "replace",
    "path": "/scriptConfig/dialog/crewmember/unfollow/default/default/2",
    "value": "Estaré por aquí de momento. ¡Cuídate mientras estés ahí fuera!"
  },
  {
    "op": "replace",
    "path": "/scriptConfig/dialog/crewmember/unfollow/default/default/3",
    "value": "Me quedaré aquí por ahora. ¡No dejes que los lilodons te muerdan!"
  },
  {
    "op": "replace",
    "path": "/scriptConfig/dialog/crewmember/unfollow/apex/default/0",
    "value": "No tomes riesgos innecesarios. Me encontrarás aquí mismo."
  },
  {
    "op": "replace",
    "path": "/scriptConfig/dialog/crewmember/unfollow/apex/default/1",
    "value": "Te esperaré aquí. Sé cuidadoso."
  },
  {
    "op": "replace",
    "path": "/scriptConfig/dialog/crewmember/unfollow/apex/default/2",
    "value": "Cuídate mientras estés ahí fuera. Estaré aquí cuando vuelvas."
  },
  {
    "op": "replace",
    "path": "/scriptConfig/dialog/crewmember/unfollow/avian/default/0",
    "value": "Mantente a salvo mientras estés ahí fuera ¿de acuerdo? ¡Regresa de inmediato si me necesitas!"
  },
  {
    "op": "replace",
    "path": "/scriptConfig/dialog/crewmember/unfollow/avian/default/1",
